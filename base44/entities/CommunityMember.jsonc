{
  "name": "CommunityMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "first_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e4\u05e8\u05d8\u05d9"
    },
    "last_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "id_number": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df (\u05e7\u05d5\u05d5\u05d9)"
    },
    "mobile": {
      "type": "string",
      "title": "\u05e0\u05d9\u05d9\u05d3"
    },
    "email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ],
      "title": "\u05de\u05d2\u05d3\u05e8"
    },
    "occupation": {
      "type": "string",
      "title": "\u05e2\u05d9\u05e1\u05d5\u05e7"
    },
    "city": {
      "type": "string",
      "title": "\u05e2\u05d9\u05e8"
    },
    "street": {
      "type": "string",
      "title": "\u05e8\u05d7\u05d5\u05d1"
    },
    "house_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d1\u05d9\u05ea"
    },
    "apartment": {
      "type": "string",
      "title": "\u05d3\u05d9\u05e8\u05d4"
    },
    "address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05dc\u05d0\u05d4"
    },
    "neighborhood": {
      "type": "string",
      "title": "\u05e9\u05db\u05d5\u05e0\u05d4 / \u05d0\u05d6\u05d5\u05e8"
    },
    "box_status": {
      "type": "string",
      "enum": [
        "has",
        "wants",
        "no"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e7\u05d5\u05e4\u05d4"
    },
    "family_size": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05e4\u05e9\u05d5\u05ea \u05d1\u05d1\u05d9\u05ea"
    },
    "spouse_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "spouse_id": {
      "type": "string",
      "title": "\u05ea.\u05d6. \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "spouse_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "spouse_birth_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea. \u05dc\u05d9\u05d3\u05d4 \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "spouse_occupation": {
      "type": "string",
      "title": "\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "father_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d1 (\u05de\u05dc\u05d0, \u05d9\u05e9\u05df)"
    },
    "father_last_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc - \u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "father_first_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc - \u05e9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05d0\u05d1"
    },
    "father_mother_first_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc - \u05e9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05d0\u05dd"
    },
    "father_phone": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc - \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "father_city": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc - \u05e2\u05d9\u05e8"
    },
    "mother_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05dd (\u05de\u05dc\u05d0, \u05d9\u05e9\u05df)"
    },
    "mother_last_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d0\u05e9\u05d4 - \u05e9\u05dd \u05de\u05e9\u05e4\u05d7\u05d4"
    },
    "mother_first_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d0\u05e9\u05d4 - \u05e9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05d0\u05d1"
    },
    "mother_mother_first_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d0\u05e9\u05d4 - \u05e9\u05dd \u05e4\u05e8\u05d8\u05d9 \u05d0\u05dd"
    },
    "mother_phone": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d0\u05e9\u05d4 - \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "mother_city": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d9 \u05d4\u05d0\u05e9\u05d4 - \u05e2\u05d9\u05e8"
    },
    "bank_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d1\u05e0\u05e7"
    },
    "bank_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d1\u05e0\u05e7"
    },
    "branch_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05e0\u05d9\u05e3"
    },
    "account_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05df"
    },
    "children_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd"
    },
    "children_json": {
      "type": "string",
      "title": "\u05e4\u05e8\u05d8\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd (JSON)"
    },
    "form_update_date": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d3\u05db\u05d5\u05df \u05d1\u05d8\u05d5\u05e4\u05e1"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}