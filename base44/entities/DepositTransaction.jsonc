{
  "name": "DepositTransaction",
  "type": "object",
  "properties": {
    "deposit_id": {
      "type": "string",
      "title": "\u05e4\u05d9\u05e7\u05d3\u05d5\u05df"
    },
    "member_id": {
      "type": "string",
      "title": "\u05d7\u05d1\u05e8 \u05e7\u05d4\u05d9\u05dc\u05d4"
    },
    "type": {
      "type": "string",
      "enum": [
        "hk_deduction",
        "hk_deposit",
        "redemption",
        "manual_deduction"
      ],
      "default": "redemption",
      "title": "\u05e1\u05d5\u05d2 \u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "transfer",
        "card",
        "other"
      ],
      "default": "transfer",
      "title": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "nedarim_history",
        "nedarim_sync"
      ],
      "default": "manual",
      "title": "\u05de\u05e7\u05d5\u05e8"
    },
    "nedarim_transaction_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05e1\u05e7\u05ea \u05e0\u05d3\u05e8\u05d9\u05dd (\u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "deposit_id",
    "type",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}