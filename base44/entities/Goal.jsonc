{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d9\u05e2\u05d3"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "owner_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "owner_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "paused"
      ],
      "default": "draft",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "tasks": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05d6\u05de\u05e0\u05d9\u05dd (JSON)"
    },
    "clarifying_questions": {
      "type": "string",
      "title": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d1\u05d4\u05e8\u05d4 (JSON)"
    },
    "ai_context": {
      "type": "string",
      "title": "\u05d4\u05e7\u05e9\u05e8 AI"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}