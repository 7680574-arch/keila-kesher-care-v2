{
  "name": "MeetingItem",
  "type": "object",
  "properties": {
    "meeting_id": {
      "type": "string",
      "title": "\u05d9\u05e9\u05d9\u05d1\u05d4"
    },
    "kind": {
      "type": "string",
      "enum": [
        "problem",
        "solution"
      ],
      "default": "problem",
      "title": "\u05e1\u05d5\u05d2 (\u05d1\u05e2\u05d9\u05d4 / \u05e4\u05ea\u05e8\u05d5\u05df)"
    },
    "text": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df"
    },
    "problem_id": {
      "type": "string",
      "title": "\u05d1\u05e2\u05d9\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea (\u05dc\u05e4\u05ea\u05e8\u05d5\u05df)"
    },
    "author_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e1\u05d9\u05e3"
    }
  },
  "required": [
    "meeting_id",
    "kind",
    "text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}