{
  "name": "NedarimDonation",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05e1\u05e7\u05d4"
    },
    "transaction_id_num": {
      "type": "number",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05e1\u05e7\u05d4 (\u05de\u05e1\u05e4\u05e8\u05d9)"
    },
    "transaction_time": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05e2\u05e1\u05e7\u05d4"
    },
    "transaction_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05e1\u05e7\u05d4 (\u05dc\u05e1\u05d9\u05e0\u05d5\u05df)"
    },
    "client_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05ea\u05d5\u05e8\u05dd"
    },
    "zeout": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "donor_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d5\u05e8\u05dd (\u05dc\u05d0 \u05de\u05d4\u05e7\u05d4\u05d9\u05dc\u05d4)"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "mail": {
      "type": "string",
      "title": "\u05de\u05d9\u05d9\u05dc"
    },
    "address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea"
    },
    "amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd"
    },
    "currency": {
      "type": "number",
      "title": "\u05de\u05d8\u05d1\u05e2 (1=\u05e9\u05e7\u05dc, 2=\u05d3\u05d5\u05dc\u05e8)"
    },
    "groupe": {
      "type": "string",
      "title": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "comments": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "transaction_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05e2\u05e1\u05e7\u05d4"
    },
    "confirmation": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "last_num": {
      "type": "string",
      "title": "4 \u05e1\u05e4\u05e8\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea"
    },
    "keva_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d5\u05e8\u05d0\u05ea \u05e7\u05d1\u05e2"
    },
    "masof_name": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "tashloumim": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd"
    },
    "kabala_id": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e7\u05d1\u05dc\u05d4"
    },
    "invoice_data2": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e1\u05de\u05da \u05e7\u05d1\u05dc\u05d4"
    },
    "manual_assigned": {
      "type": "boolean",
      "default": false,
      "title": "\u05e9\u05d5\u05d9\u05da \u05d9\u05d3\u05e0\u05d9\u05ea"
    }
  },
  "required": [
    "transaction_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}