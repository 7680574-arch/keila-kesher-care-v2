{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "kind": {
      "type": "string",
      "enum": [
        "event",
        "campaign"
      ],
      "default": "event",
      "title": "\u05e1\u05d5\u05d2 (\u05d0\u05d9\u05e8\u05d5\u05e2 / \u05e7\u05de\u05e4\u05d9\u05d9\u05df)"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "location": {
      "type": "string",
      "title": "\u05de\u05d9\u05e7\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "planning",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "manager_email": {
      "type": "string",
      "title": "\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e8\u05d0\u05e9\u05d9 (\u05d0\u05d9\u05de\u05d9\u05d9\u05dc)"
    },
    "manager_name": {
      "type": "string",
      "title": "\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e8\u05d0\u05e9\u05d9 (\u05e9\u05dd)"
    },
    "income_goal": {
      "type": "number",
      "title": "\u05d9\u05e2\u05d3 \u05d4\u05db\u05e0\u05e1\u05d5\u05ea"
    },
    "budget": {
      "type": "number",
      "title": "\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05de\u05ea\u05d5\u05db\u05e0\u05df"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}