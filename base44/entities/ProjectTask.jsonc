{
  "name": "ProjectTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "goal_id": {
      "type": "string",
      "title": "\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "goal_title": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "parent_task_id": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05ea \u05d0\u05d1 (\u05dc\u05ea\u05ea-\u05de\u05e9\u05d9\u05de\u05d4)"
    },
    "assignee_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "assignee_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "assignee_email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "done",
        "need_help"
      ],
      "default": "pending",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "estimated_hours": {
      "type": "number",
      "title": "\u05e9\u05e2\u05d5\u05ea \u05de\u05d5\u05e2\u05e8\u05db\u05d5\u05ea"
    },
    "cost": {
      "type": "number",
      "title": "\u05e2\u05dc\u05d5\u05ea"
    },
    "paid_amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05e9\u05e9\u05d5\u05dc\u05dd"
    },
    "summary": {
      "type": "string",
      "title": "\u05e1\u05d9\u05db\u05d5\u05dd"
    },
    "created_by_ai": {
      "type": "boolean",
      "default": false,
      "title": "\u05e0\u05d5\u05e6\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 AI"
    },
    "order": {
      "type": "number",
      "title": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "title",
    "goal_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}