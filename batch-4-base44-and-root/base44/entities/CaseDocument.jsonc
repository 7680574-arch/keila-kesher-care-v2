{
  "name": "CaseDocument",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "title": "\u05ea\u05d9\u05e7"
    },
    "client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7"
    },
    "title": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05e1\u05de\u05da"
    },
    "file_url": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d1\u05e5"
    },
    "file_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d5\u05d1\u05e5 \u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "file_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05e7\u05d5\u05d1\u05e5"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e2\u05dc\u05d0\u05d4"
    },
    "drive_file_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d5\u05d1\u05e5 \u05d1-Google Drive"
    }
  },
  "required": [
    "case_id",
    "title",
    "file_url"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}