{
  "name": "CaseNote",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "title": "\u05ea\u05d9\u05e7"
    },
    "client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7"
    },
    "content": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "call",
        "visit",
        "document",
        "meeting",
        "referral"
      ],
      "default": "note",
      "title": "\u05e1\u05d5\u05d2 \u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "author": {
      "type": "string",
      "title": "\u05e0\u05e8\u05e9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9"
    },
    "action_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "action_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e4\u05e2\u05d5\u05dc\u05d4"
    }
  },
  "required": [
    "case_id",
    "content"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}