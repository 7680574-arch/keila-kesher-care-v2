{
  "name": "CaseTransaction",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "title": "\u05ea\u05d9\u05e7"
    },
    "client_id": {
      "type": "string",
      "title": "\u05dc\u05e7\u05d5\u05d7"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8 / \u05e4\u05e8\u05d8\u05d9\u05dd"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "category": {
      "type": "string",
      "title": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "paid": {
      "type": "boolean",
      "default": true,
      "title": "\u05e9\u05d5\u05dc\u05dd / \u05d4\u05ea\u05e7\u05d1\u05dc"
    }
  },
  "required": [
    "case_id",
    "type",
    "amount",
    "date"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}