{
  "name": "CleaningBuilding",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd / \u05de\u05e1\u05e4\u05e8 \u05d1\u05e0\u05d9\u05d9\u05df"
    },
    "address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea"
    },
    "parking_lots_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e0\u05d9\u05d5\u05ea"
    },
    "responsible_name": {
      "type": "string",
      "title": "\u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "responsible_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d7\u05e8\u05d0\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "dirty",
        "in_progress"
      ],
      "default": "dirty",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e0\u05d9\u05e7\u05d9\u05d5\u05df"
    },
    "last_cleaned_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "residents": {
      "type": "string",
      "title": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d3\u05d9\u05d9\u05e8\u05d9\u05dd (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}