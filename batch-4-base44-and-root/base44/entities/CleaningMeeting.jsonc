{
  "name": "CleaningMeeting",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05d4"
    },
    "location": {
      "type": "string",
      "title": "\u05de\u05e7\u05d5\u05dd"
    },
    "participants": {
      "type": "string",
      "title": "\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd (JSON)"
    },
    "agenda": {
      "type": "string",
      "title": "\u05e1\u05d3\u05e8 \u05d9\u05d5\u05dd"
    },
    "summary": {
      "type": "string",
      "title": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d9\u05e9\u05d9\u05d1\u05d4"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}