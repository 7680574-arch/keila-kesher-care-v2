{
  "name": "CleaningTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "type": {
      "type": "string",
      "enum": [
        "task",
        "note"
      ],
      "default": "task",
      "title": "\u05e1\u05d5\u05d2 (\u05de\u05e9\u05d9\u05de\u05d4 / \u05d4\u05e2\u05e8\u05d4)"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "building_id": {
      "type": "string",
      "title": "\u05d1\u05e0\u05d9\u05d9\u05df \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "meeting_id": {
      "type": "string",
      "title": "\u05d9\u05e9\u05d9\u05d1\u05d4 \u05de\u05e9\u05d5\u05d9\u05db\u05ea"
    },
    "volunteer_id": {
      "type": "string",
      "title": "\u05de\u05ea\u05e0\u05d3\u05d1 \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "committee_member_id": {
      "type": "string",
      "title": "\u05e0\u05e6\u05d9\u05d2 / \u05d7\u05d1\u05e8 \u05d5\u05e2\u05d3\u05d4 \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "assignee_name": {
      "type": "string",
      "title": "\u05e0\u05e6\u05d9\u05d2 (\u05d8\u05e7\u05e1\u05d8 \u05d7\u05d5\u05e4\u05e9\u05d9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done"
      ],
      "default": "pending",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}