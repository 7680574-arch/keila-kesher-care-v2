{
  "name": "Deposit",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "title": "\u05d7\u05d1\u05e8 \u05e7\u05d4\u05d9\u05dc\u05d4"
    },
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "id_number": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "initial_amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05e4\u05d9\u05e7\u05d3\u05d5\u05df \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9"
    },
    "hk_instruction_number": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d5\u05e8\u05d0\u05ea \u05e7\u05d1\u05e2 \u05e8\u05d0\u05e9\u05d5\u05df (\u05d4\u05d5\u05f4\u05e7) - \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8"
    },
    "hk_amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d5\u05f4\u05e7 \u05e8\u05d0\u05e9\u05d5\u05df \u05e7\u05d1\u05d5\u05e2 - \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8"
    },
    "hk_type": {
      "type": "string",
      "enum": [
        "deduction",
        "deposit"
      ],
      "default": "deduction",
      "title": "\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05d5\u05f4\u05e7 \u05e8\u05d0\u05e9\u05d5\u05df - \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8"
    },
    "hk_instructions": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05e7\u05d1\u05e2 (JSON: \u05de\u05e1\u05e4\u05e8, \u05e1\u05db\u05d5\u05dd, \u05db\u05d9\u05d5\u05d5\u05df)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "redeemed",
        "closed"
      ],
      "default": "active",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "initial_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}