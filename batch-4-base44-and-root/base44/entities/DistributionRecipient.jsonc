{
  "name": "DistributionRecipient",
  "type": "object",
  "properties": {
    "distribution_id": {
      "type": "string",
      "title": "\u05d7\u05dc\u05d5\u05e7\u05d4"
    },
    "member_id": {
      "type": "string",
      "title": "\u05d7\u05d1\u05e8 \u05e7\u05d4\u05d9\u05dc\u05d4"
    },
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e7\u05d1\u05dc"
    },
    "id_number": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "family_size": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05e4\u05e9\u05d5\u05ea"
    },
    "children_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd (\u05e0\u05e9\u05de\u05e8 \u05d1\u05e7\u05d9\u05d1\u05d5\u05e2 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd)"
    },
    "neighborhood": {
      "type": "string",
      "title": "\u05e9\u05db\u05d5\u05e0\u05d4"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "address": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea"
    },
    "amount": {
      "type": "number",
      "title": "\u05e9\u05d5\u05d5\u05d9 \u05d4\u05d7\u05dc\u05d5\u05e7\u05d4 \u05dc\u05de\u05e7\u05d1\u05dc"
    },
    "member_participation": {
      "type": "number",
      "title": "\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d4\u05d0\u05d1\u05e8\u05da"
    },
    "fund_participation": {
      "type": "number",
      "title": "\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d4\u05e7\u05d5\u05e4\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "pending",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "tasks_done": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05d1\u05d5\u05e6\u05e2\u05d5 (JSON)"
    }
  },
  "required": [
    "distribution_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}