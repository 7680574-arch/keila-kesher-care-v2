{
  "name": "FundraisingEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 / \u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "invitees",
        "community"
      ],
      "default": "invitees",
      "title": "\u05e1\u05d5\u05d2 \u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "linked_event_id": {
      "type": "string",
      "title": "\u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05d5\u05d6\u05de\u05e0\u05d9\u05dd \u05de\u05e9\u05d5\u05d9\u05da"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "goal_amount": {
      "type": "number",
      "title": "\u05d9\u05e2\u05d3 \u05ea\u05e8\u05d5\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed"
      ],
      "default": "planning",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "tasks": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}