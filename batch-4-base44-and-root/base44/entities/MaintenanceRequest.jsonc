{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e7\u05e8\u05d9\u05d0\u05d4"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05ea\u05e7\u05dc\u05d4"
    },
    "location": {
      "type": "string",
      "title": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "\u05d3\u05d7\u05d9\u05e4\u05d5\u05ea"
    },
    "image_uri": {
      "type": "string",
      "title": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05e6\u05d5\u05e8\u05e4\u05ea (URI \u05e4\u05e8\u05d8\u05d9)"
    },
    "requester_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e4\u05d5\u05ea\u05d7 \u05d4\u05e7\u05e8\u05d9\u05d0\u05d4"
    },
    "requester_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "requester_email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "new",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}