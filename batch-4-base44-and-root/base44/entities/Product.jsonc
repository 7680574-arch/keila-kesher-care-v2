{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e6\u05e8"
    },
    "sku": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d3 \u05de\u05d5\u05e6\u05e8 (\u05de\u05e7\"\u05d8)"
    },
    "quantity": {
      "type": "number",
      "title": "\u05db\u05de\u05d5\u05ea"
    },
    "price": {
      "type": "number",
      "title": "\u05de\u05d7\u05d9\u05e8"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}