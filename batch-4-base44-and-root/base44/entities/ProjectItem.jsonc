{
  "name": "ProjectItem",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d9\u05e9\u05df"
    },
    "goal_id": {
      "type": "string",
      "title": "\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05de\u05e2\u05e8\u05db\u05ea \u05d7\u05d3\u05e9\u05d4)"
    },
    "type": {
      "type": "string",
      "enum": [
        "task",
        "income",
        "expense",
        "participant",
        "agenda"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05e9\u05d5\u05e8\u05d4"
    },
    "title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea / \u05e9\u05dd"
    },
    "amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd (\u05dc\u05d4\u05db\u05e0\u05e1\u05d4 / \u05d4\u05d5\u05e6\u05d0\u05d4)"
    },
    "paid_amount": {
      "type": "number",
      "title": "\u05e1\u05db\u05d5\u05dd \u05e9\u05e9\u05d5\u05dc\u05dd (\u05dc\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea - \u05ea\u05e9\u05dc\u05d5\u05dd \u05d7\u05dc\u05e7\u05d9)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 (\u05de\u05e9\u05d9\u05de\u05d4: pending/done; \u05de\u05e9\u05ea\u05ea\u05e3: invited/confirmed/declined/attended)"
    },
    "assignee_email": {
      "type": "string",
      "title": "\u05d0\u05d7\u05e8\u05d0\u05d9 (\u05d0\u05d9\u05de\u05d9\u05d9\u05dc)"
    },
    "assignee_name": {
      "type": "string",
      "title": "\u05d0\u05d7\u05e8\u05d0\u05d9 (\u05e9\u05dd)"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df (\u05de\u05e9\u05ea\u05ea\u05e3)"
    },
    "email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc (\u05de\u05e9\u05ea\u05ea\u05e3)"
    },
    "guests_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d2\u05d9\u05e2\u05d9\u05dd (\u05de\u05e9\u05ea\u05ea\u05e3)"
    },
    "category": {
      "type": "string",
      "title": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "order": {
      "type": "number",
      "title": "\u05e1\u05d3\u05e8 (\u05d1\u05e1\u05d3\u05e8 \u05d9\u05d5\u05dd)"
    },
    "duration_minutes": {
      "type": "number",
      "title": "\u05de\u05e9\u05da \u05d1\u05d3\u05e7\u05d5\u05ea (\u05d1\u05e1\u05d3\u05e8 \u05d9\u05d5\u05dd)"
    },
    "time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05d4 (\u05d1\u05e1\u05d3\u05e8 \u05d9\u05d5\u05dd)"
    },
    "member_id": {
      "type": "string",
      "title": "\u05d7\u05d1\u05e8 \u05e7\u05d4\u05d9\u05dc\u05d4 \u05de\u05e9\u05d5\u05d9\u05da (\u05de\u05d5\u05d6\u05de\u05df)"
    },
    "tasks_done": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05d1\u05d5\u05e6\u05e2\u05d5 (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}