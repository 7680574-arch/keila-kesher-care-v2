{
  "name": "ProjectUpdate",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "title": "\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "task_title": {
      "type": "string",
      "title": "\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "user_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "on_track",
        "blocked",
        "done",
        "need_help"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e2\u05d3\u05db\u05d5\u05df"
    },
    "message": {
      "type": "string",
      "title": "\u05d4\u05d5\u05d3\u05e2\u05d4"
    }
  },
  "required": [
    "task_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}