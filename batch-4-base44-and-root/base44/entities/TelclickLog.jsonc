{
  "name": "TelclickLog",
  "type": "object",
  "properties": {
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05ea\u05d6\u05de\u05d5\u05df \u05e8\u05d9\u05e2\u05e0\u05d5\u05df"
    },
    "reps": {
      "type": "string",
      "title": "\u05e0\u05e6\u05d9\u05d2\u05d9\u05dd (JSON)"
    },
    "count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05e6\u05d9\u05d2\u05d9\u05dd"
    }
  },
  "required": [
    "fetched_at",
    "reps"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}