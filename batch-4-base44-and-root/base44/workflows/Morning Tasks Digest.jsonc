          "with": {
            "function_name": "sendMorningTasksDigest",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05d9\u05d9\u05dc \u05d1\u05d5\u05e7\u05e8 \u05dc\u05de\u05d8\u05e4\u05dc\u05d9\u05dd",
            "description": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e4\u05ea\u05d5\u05d7\u05d5\u05ea, \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05dd \u05d5\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05dd"
          }
