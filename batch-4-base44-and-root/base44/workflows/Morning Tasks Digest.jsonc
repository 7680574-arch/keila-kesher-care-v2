{
  "name": "Morning Tasks Digest",
  "description": "\u05de\u05d9\u05d9\u05dc \u05ea\u05d7\u05d9\u05dc\u05ea \u05d9\u05d5\u05dd \u05dc\u05db\u05dc \u05d0\u05d7\u05e8\u05d0\u05d9: \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e4\u05ea\u05d5\u05d7\u05d5\u05ea, \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05dd \u05d5\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05dd, \u05db\u05dc \u05d9\u05d5\u05dd \u05d1-07:00",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
