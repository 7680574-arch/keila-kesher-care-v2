{
  "name": "Weekly Drive Backup",
  "description": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc \u05db\u05dc \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05dc\u05d2\u05d5\u05d2\u05dc \u05d3\u05e8\u05d9\u05d9\u05d1, \u05db\u05dc \u05d9\u05d5\u05dd \u05e8\u05d0\u05e9\u05d5\u05df \u05d1-02:00",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * 0",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_drive_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_backup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupAllToDrive",
            "args": {
              "mode": "drive"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05dc\u05d3\u05e8\u05d9\u05d9\u05d1",
            "description": "\u05db\u05dc \u05d4\u05d8\u05d1\u05dc\u05d0\u05d5\u05ea \u05db\u05e7\u05d1\u05e6\u05d9 CSV"
          }
        }
      }
    ]
  }
}